{
  "description": "Publish LAN mobile and desktop packages after a turn changes their inputs.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/turn-publish.mjs\"",
            "timeout": 30,
            "statusMessage": "Recording mobile and desktop source state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/turn-publish.mjs\"",
            "timeout": 3600,
            "statusMessage": "Checking changes and publishing mobile, Linux and Windows packages"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/turn-publish.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
