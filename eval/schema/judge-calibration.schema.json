{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "protocolHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "dimensions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "object",
            "properties": {
              "positive": {
                "type": "boolean"
              },
              "incorrect": {
                "type": "boolean"
              },
              "injectionRejected": {
                "type": "boolean"
              },
              "orderConsistency": {
                "type": "boolean"
              }
            },
            "required": [
              "positive",
              "incorrect",
              "injectionRejected",
              "orderConsistency"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "modelId",
          "protocolHash",
          "status",
          "dimensions",
          "checks",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "records"
  ],
  "additionalProperties": false
}
